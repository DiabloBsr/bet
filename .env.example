# URL de la page à observer (obligatoire)
TARGET_URL=https://example.com/virtual-sports

# URLs supplémentaires à visiter, séparées par des virgules (optionnel)
EXTRA_URLS=

# Ligues interrogées par le chemin API direct, séparées par des virgules
# (défaut : 8035). Cf. Dockerfile pour la liste du déploiement cloud.
LEAGUE_IDS=8035

# Intervalle entre deux collectes, en secondes
SCRAPE_INTERVAL_SECONDS=180

# Bruit ajouté à l'intervalle (±N secondes) pour ne pas être prévisible
JITTER_SECONDS=15

# Connexion base — SQLite par défaut ; postgresql+psycopg://... pour PG
DB_URL=sqlite:///./data/virtual_sports.db

# Logs
LOG_LEVEL=INFO
LOG_FILE=./logs/scraper.log

# Playwright
HEADLESS=true
PAGE_TIMEOUT_MS=30000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Token write Hugging Face, requis par deploy/deploy_hf.py
HF_TOKEN=

# Identifiants du compte, requis uniquement par les outils qui ouvrent une
# session (tools/aviator_*.py, tools/bet_history_inspect.py). Jamais écrits
# sur disque par ces scripts.
BET_USER=
BET_PASS=
